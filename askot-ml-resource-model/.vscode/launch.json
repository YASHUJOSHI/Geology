{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pipeline: default run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline: 5 m blocks, 4% cut-off",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "args": ["--block-size", "5", "--cutoff", "4.0", "--skip-cv"],
      "console": "integratedTerminal"
    }
  ]
}
